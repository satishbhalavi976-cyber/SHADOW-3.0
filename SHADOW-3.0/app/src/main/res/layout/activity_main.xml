<?xml version="1.0" encoding="utf-8"?>
<!-- SHADOW 3.0 Main Activity Layout - Black & White Interface -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shadow_black"
    tools:context=".ui.MainActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/shadow_black"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="16dp">

            <!-- SHADOW Logo / Title -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHADOW"
                android:textColor="@color/shadow_white"
                android:textSize="22sp"
                android:fontFamily="sans-serif-thin"
                android:letterSpacing="0.3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.0"
                android:textColor="@color/shadow_text_hint_dark"
                android:textSize="11sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@id/tvAppTitle"
                app:layout_constraintBaseline_toBaselineOf="@id/tvAppTitle" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/btnHistory"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_history"
                    android:contentDescription="@string/history"
                    android:tint="@color/shadow_text_secondary_dark" />

                <ImageButton
                    android:id="@+id/btnNewChat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_new_chat"
                    android:contentDescription="@string/new_chat"
                    android:tint="@color/shadow_text_secondary_dark" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings"
                    android:tint="@color/shadow_text_secondary_dark" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Thin divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/shadow_divider_dark" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Chat RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChat"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            android:scrollbarStyle="outsideOverlay"
            android:fadeScrollbars="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/layoutInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Empty State (shown when no messages) -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/layoutInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Animated Shadow Circle -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center">

                <View
                    android:id="@+id/vPulseOuter"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_pulse_circle_outer"
                    android:alpha="0.2" />

                <View
                    android:id="@+id/vPulseMid"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pulse_circle_mid"
                    android:alpha="0.4" />

                <ImageView
                    android:id="@+id/ivShadowLogo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shadow_logo"
                    android:contentDescription="SHADOW" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="SHADOW 3.0"
                android:textColor="@color/shadow_white"
                android:textSize="28sp"
                android:fontFamily="sans-serif-thin"
                android:letterSpacing="0.2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your AI Voice Assistant"
                android:textColor="@color/shadow_text_hint_dark"
                android:textSize="14sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05" />

            <!-- Suggestion Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSuggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐 Set a timer"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:textColor="@color/shadow_text_secondary_dark"
                    app:chipBackgroundColor="@color/shadow_dark_card"
                    app:chipStrokeColor="@color/shadow_divider_dark"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤 Weather today"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:textColor="@color/shadow_text_secondary_dark"
                    app:chipBackgroundColor="@color/shadow_dark_card"
                    app:chipStrokeColor="@color/shadow_divider_dark"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸 Scan text"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:textColor="@color/shadow_text_secondary_dark"
                    app:chipBackgroundColor="@color/shadow_dark_card"
                    app:chipStrokeColor="@color/shadow_divider_dark"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞 Call someone"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:textColor="@color/shadow_text_secondary_dark"
                    app:chipBackgroundColor="@color/shadow_dark_card"
                    app:chipStrokeColor="@color/shadow_divider_dark"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

        <!-- Listening Indicator (shown while recording) -->
        <LinearLayout
            android:id="@+id/layoutListening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/layoutInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Waveform Visualizer -->
            <com.project.shadow.ui.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginHorizontal="32dp" />

            <TextView
                android:id="@+id/tvListeningStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/listening"
                android:textColor="@color/shadow_white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.1" />

        </LinearLayout>

        <!-- Bottom Input Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/shadow_black"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Top divider -->
            <View
                android:id="@+id/dividerInput"
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:background="@color/shadow_divider_dark"
                android:layout_marginBottom="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Camera Button -->
            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:src="@drawable/ic_camera"
                android:contentDescription="@string/camera"
                android:tint="@color/shadow_text_secondary_dark"
                android:padding="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerInput" />

            <!-- Text Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMessage"
                style="@style/Input.Shadow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintStart_toEndOf="@id/btnCamera"
                app:layout_constraintEnd_toStartOf="@id/btnVoice"
                app:layout_constraintTop_toBottomOf="@id/dividerInput"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/type_message"
                    android:textColor="@color/shadow_white"
                    android:textColorHint="@color/shadow_text_hint_dark"
                    android:imeOptions="actionSend"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:background="@null"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Voice / Send Button -->
            <ImageButton
                android:id="@+id/btnVoice"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_voice_button"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/tap_to_speak"
                android:tint="@color/shadow_black"
                android:padding="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerInput" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
