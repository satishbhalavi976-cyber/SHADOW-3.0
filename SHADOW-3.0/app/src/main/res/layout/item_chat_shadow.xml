<?xml version="1.0" encoding="utf-8"?>
<!-- Chat Message Item - SHADOW AI Assistant -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginVertical="4dp"
    android:paddingStart="8dp"
    android:paddingEnd="48dp">

    <!-- SHADOW label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHADOW"
        android:textColor="@color/shadow_text_hint_dark"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.15"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/shadow_dark_input"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/shadow_white"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.5"
                android:maxWidth="280dp" />

            <!-- Action buttons row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/btnCopy"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_copy"
                    android:background="@null"
                    android:tint="@color/shadow_text_hint_dark"
                    android:contentDescription="@string/copy_text"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/btnSpeak"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_speaker"
                    android:background="@null"
                    android:tint="@color/shadow_text_hint_dark"
                    android:contentDescription="@string/speak_response"
                    android:padding="4dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="4dp"
        android:textColor="@color/shadow_text_hint_dark"
        android:textSize="10sp" />

</LinearLayout>
