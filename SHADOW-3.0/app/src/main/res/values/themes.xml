<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== BASE THEME (Light / Day) ==================== -->
    <style name="Theme.Shadow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/shadow_white</item>
        <item name="colorOnPrimary">@color/shadow_black</item>
        <item name="colorPrimaryContainer">@color/shadow_light_card</item>
        <item name="colorOnPrimaryContainer">@color/shadow_black</item>
        <item name="colorSecondary">@color/shadow_light_card</item>
        <item name="colorOnSecondary">@color/shadow_black</item>
        <item name="colorSurface">@color/shadow_light_surface</item>
        <item name="colorOnSurface">@color/shadow_black</item>
        <item name="android:colorBackground">@color/shadow_white</item>
        <item name="colorOnBackground">@color/shadow_black</item>
        <item name="colorError">@color/shadow_error</item>
        <item name="android:windowBackground">@color/shadow_white</item>
        <item name="android:statusBarColor">@color/shadow_white</item>
        <item name="android:navigationBarColor">@color/shadow_white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <!-- Splash / Onboarding Theme -->
    <style name="Theme.Shadow.Splash" parent="Theme.Shadow">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/shadow_black</item>
    </style>

    <!-- Settings Theme -->
    <style name="Theme.Shadow.Settings" parent="Theme.Shadow">
        <item name="android:windowBackground">@color/shadow_dark_surface</item>
    </style>

    <!-- ==================== TEXT STYLES ==================== -->
    <style name="TextStyle.Shadow.Title" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/shadow_white</item>
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TextStyle.Shadow.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/shadow_text_secondary_dark</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextStyle.Shadow.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/shadow_text_primary_dark</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextStyle.Shadow.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/shadow_text_hint_dark</item>
    </style>

    <!-- ==================== BUTTON STYLES ==================== -->
    <style name="Button.Shadow.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/shadow_white</item>
        <item name="android:textColor">@color/shadow_black</item>
        <item name="cornerRadius">30dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Button.Shadow.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/shadow_white</item>
        <item name="android:textColor">@color/shadow_white</item>
        <item name="cornerRadius">30dp</item>
    </style>

    <style name="Button.Shadow.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/shadow_text_secondary_dark</item>
    </style>

    <!-- ==================== CARD STYLES ==================== -->
    <style name="Card.Shadow" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/shadow_dark_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/shadow_divider_dark</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Card.Shadow.Chat.User" parent="Card.Shadow">
        <item name="cardBackgroundColor">@color/shadow_white</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <style name="Card.Shadow.Chat.Assistant" parent="Card.Shadow">
        <item name="cardBackgroundColor">@color/shadow_dark_input</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <!-- ==================== INPUT STYLES ==================== -->
    <style name="Input.Shadow" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/shadow_dark_input</item>
        <item name="boxStrokeColor">@color/shadow_divider_dark</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/shadow_text_hint_dark</item>
        <item name="android:textColorHint">@color/shadow_text_hint_dark</item>
        <item name="shapeAppearanceOverlay">@style/ShapeRound</item>
    </style>

    <style name="ShapeRound" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30dp</item>
    </style>

</resources>
